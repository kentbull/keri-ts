{
  "name": "keri-ts",
  "version": "2.0.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts",
    "./runtime": "./runtime.ts",
    "./db": "./db.ts"
  },
  "tasks": {
    "fmt": "deno run -A npm:dprint@0.49.0 fmt --config ../../dprint.json .",
    "fmt:check": "deno run -A npm:dprint@0.49.0 check --config ../../dprint.json .",
    "lint": "deno lint mod.ts runtime.ts db.ts src test scripts --rules-tags=recommended --rules-exclude=no-import-prefix,no-unversioned-import,verbatim-module-syntax,no-explicit-any,no-unused-vars,prefer-const,require-yield",
    "check": "deno check mod.ts runtime.ts db.ts ../cesr/mod.ts && deno run -A scripts/check_library_boundary.ts",
    "quality": "deno task fmt:check && deno task lint && deno task check && deno task version:check && deno task test:quality",
    "manifest:sync": "deno run -A ../../scripts/sync_manifest_versions.ts",
    "manifest:check": "deno run -A ../../scripts/sync_manifest_versions.ts --check",
    "version:generate": "deno run -A ../../scripts/generate_versions.ts --only keri",
    "version:check": "deno task manifest:check && deno run -A ../../scripts/generate_versions.ts --check --only keri",
    "build:npm": "deno task version:generate && deno run -A scripts/build_npm.ts",
    "setup": "deno task setup:compat-lmdb",
    "setup:compat-lmdb": "bash scripts/setup_lmdb_v1.sh",
    "check:surface": "deno run -A scripts/check_library_boundary.ts",
    "test": "deno run -A ../../scripts/ci/run-keri-test-group.ts full",
    "test:quality": "deno run -A ../../scripts/ci/run-keri-test-group.ts quality",
    "test:audit": "deno run -A ../../scripts/ci/run-keri-test-group.ts audit",
    "test:qualification": "deno run -A ../../scripts/ci/run-keri-test-group.ts qualification",
    "test:quality:app-fast-parallel": "deno run -A ../../scripts/ci/run-keri-test-group.ts app-fast-parallel",
    "test:quality:interop-parity": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-parity",
    "test:quality:interop-acdc-deep": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-acdc-deep",
    "test:quality:interop-acdc-extended": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-acdc-extended",
    "test:quality:interop-delegation": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-delegation",
    "test:quality:interop-did-webs": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-did-webs",
    "test:quality:interop-witness-main": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-witness-main",
    "test:quality:runtime-medium": "deno run -A ../../scripts/ci/run-keri-test-group.ts runtime-medium",
    "test:quality:runtime-slow": "deno run -A ../../scripts/ci/run-keri-test-group.ts runtime-slow",
    "test:quality:interop-witness-cli": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-witness-cli",
    "test:quality:core-fast-a": "deno run -A ../../scripts/ci/run-keri-test-group.ts core-fast-a",
    "test:quality:app-stateful-a": "deno run -A ../../scripts/ci/run-keri-test-group.ts app-stateful-a",
    "test:quality:app-stateful-b": "deno run -A ../../scripts/ci/run-keri-test-group.ts app-stateful-b",
    "test:quality:app-fast-isolated": "deno run -A ../../scripts/ci/run-keri-test-group.ts app-fast-isolated",
    "test:quality:core-fast-b": "deno run -A ../../scripts/ci/run-keri-test-group.ts core-fast-b",
    "test:quality:db-fast": "deno run -A ../../scripts/ci/run-keri-test-group.ts db-fast",
    "test:quality:interop-keystore-parity": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-keystore-parity",
    "test:quality:interop-keystore-storage": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-keystore-storage",
    "test:quality:interop-oobi-bootstrap": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-oobi-bootstrap",
    "test:quality:interop-mailbox": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-mailbox",
    "test:quality:manual-delegation": "deno run -A ../../scripts/ci/run-keri-test-group.ts manual-delegation",
    "test:quality:manual-witness-soak": "deno run -A ../../scripts/ci/run-keri-test-group.ts manual-witness-soak",
    "test:quality:ci": "deno run -A ../../scripts/ci/run-keri-test-group.ts ci",
    "test:quality:fast": "deno run -A ../../scripts/ci/run-keri-test-group.ts fast",
    "test:quality:core-fast": "deno run -A ../../scripts/ci/run-keri-test-group.ts core-fast",
    "test:quality:app-fast": "deno run -A ../../scripts/ci/run-keri-test-group.ts app-fast",
    "test:quality:interop-witness": "deno run -A ../../scripts/ci/run-keri-test-group.ts interop-witness",
    "test:quality:extended-interop": "deno run -A ../../scripts/ci/run-keri-test-group.ts extended-interop",
    "test:quality:full": "deno run -A ../../scripts/ci/run-keri-test-group.ts full"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3",
    "@msgpack/msgpack": "npm:@msgpack/msgpack@3.1.3",
    "cbor-x": "npm:cbor-x@1.6.0",
    "cbor-x/decode": "npm:cbor-x@1.6.0/decode",
    "cbor-x/encode": "npm:cbor-x@1.6.0/encode",
    "effection": "npm:effection@^3.6.0",
    "commander": "npm:commander@^10.0.1",
    "jsr:@std/assert": "jsr:@std/assert@^0.217.0",
    "cesr-ts": "../cesr/mod.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.ns",
      "dom"
    ]
  }
}
