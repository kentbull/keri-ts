{
  "name": "@keri-ts/multisync",
  "version": "0.2.1",
  "exports": {
    "./v2": "./v2/mod.ts"
  },
  "tasks": {
    "check": "deno check v2/mod.ts scripts/build_npm.ts",
    "lint": "deno lint v2 scripts --rules-tags=recommended --rules-exclude=no-import-prefix,no-unversioned-import,verbatim-module-syntax,no-explicit-any,no-unused-vars,prefer-const,require-yield",
    "build:npm": "deno run -A scripts/build_npm.ts"
  },
  "imports": {
    "cesr-ts": "../cesr/mod.ts",
    "keri-ts/runtime": "../keri/runtime.ts",
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.ns",
      "dom"
    ]
  }
}
