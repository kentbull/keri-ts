{
  "name": "@keri-ts/wallet",
  "version": "2.1.0",
  "exports": {
    ".": "./mod.ts",
    "./web": "./web.ts",
    "./lmdb": "./lmdb.ts"
  },
  "tasks": {
    "check": "deno check mod.ts web.ts lmdb.ts scripts/*.ts test/*.ts && deno run -A scripts/check_library_boundary.ts",
    "test": "deno test -A test",
    "lint": "deno lint mod.ts web.ts lmdb.ts src scripts test --rules-tags=recommended --rules-exclude=no-import-prefix,no-unversioned-import,verbatim-module-syntax,no-explicit-any,no-unused-vars,prefer-const,require-yield",
    "check:surface": "deno run -A scripts/check_library_boundary.ts",
    "build:npm": "deno run -A scripts/build_npm.ts"
  },
  "imports": {
    "cesr-ts": "../cesr/mod.ts",
    "keri-ts/db": "../keri/db.ts",
    "keri-ts/db/indexeddb": "../keri/db-indexeddb.ts",
    "keri-ts/db/lmdb": "../keri/db-lmdb.ts",
    "keri-ts/runtime": "../keri/runtime.ts",
    "keri-ts/runtime/web": "../keri/runtime-web.ts",
    "effection": "npm:effection@^3.6.0",
    "jsr:@std/assert": "jsr:@std/assert@^0.217.0",
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.ns",
      "dom"
    ]
  }
}
